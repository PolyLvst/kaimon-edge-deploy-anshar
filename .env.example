EDGE_DEVICE_ID=edge-1
MAIN_HUB_URL=
SYNC_INTERVAL_SECONDS=30
HUB_SYNC_INTERVAL_SECONDS=30

# Face matching. Accept the closest match only if it is under FACE_THRESHOLD
# and is ahead of the runner-up by FACE_MARGIN.
#   FACE_MARGIN=0        margin check off, same as threshold-only matching
#   FACE_MARGIN=0.05     suggested starting point once students have 3 photos
#   FACE_MARGIN_MODE     absolute (gap d2-d1) or ratio (d1/d2 <= margin)
#
# 0.05 was picked on 13 Aug against 94 students. The gallery is now 223, and a
# denser gallery pushes the runner-up closer, so the same absolute gap refuses
# more: measured leave-one-out, 0.05 refuses 7.3% of correct matches now versus
# 4.4% then, and the 5th-percentile margin fell 0.053 -> 0.029. 0.03 puts the
# refusal rate back at 5.3%. Raise again once the single-photo students have
# their remaining shots enrolled.
FACE_THRESHOLD=0.60
FACE_MARGIN=0
FACE_MARGIN_MODE=absolute
FACE_TOPK=5

# Show reason / d1 / runner-up / margin on the kiosk result card. Turn this on for
# a tuning round so testers report the matcher's actual reason, then turn it off.
DEBUG_MATCH_DETAILS=false

# Idle attract video — fullscreen YouTube playback while no face is detected
IDLE_VIDEO_ENABLED=false
IDLE_VIDEO_URL=
IDLE_VIDEO_DELAY_SECONDS=30
IDLE_VIDEO_MUTED=true
