EDGE_DEVICE_ID=edge-1
MAIN_HUB_URL=
SYNC_INTERVAL_SECONDS=30
HUB_SYNC_INTERVAL_SECONDS=30

# Face matching. Accept the closest match only if it is under FACE_THRESHOLD
# and is ahead of the runner-up by FACE_MARGIN.
#   FACE_MARGIN=0        margin check off, same as threshold-only matching
#   FACE_MARGIN=0.05     suggested starting point once students have 3 photos
#   FACE_MARGIN_MODE     absolute (gap d2-d1) or ratio (d1/d2 <= margin)
FACE_THRESHOLD=0.60
FACE_MARGIN=0
FACE_MARGIN_MODE=absolute
FACE_TOPK=5

# Idle attract video — fullscreen YouTube playback while no face is detected
IDLE_VIDEO_ENABLED=false
IDLE_VIDEO_URL=
IDLE_VIDEO_DELAY_SECONDS=30
IDLE_VIDEO_MUTED=true
